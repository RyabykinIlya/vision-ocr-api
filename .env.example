# Where Ollama is reachable from inside the container.
# In docker-compose this is the bundled service name; use
# http://host.docker.internal:11434 to reuse an Ollama already running on
# the Windows/WSL host, or http://<lan-ip>:11434 for a remote box.
VISION_OLLAMA_URL=http://ollama:11434

# Any vision model pulled in Ollama. Good picks for an 8 GB GPU:
#   qwen3-vl:4b           best quality that fully fits 8 GB (fits ~4.3 GB)
#   qwen3-vl:8b           better still, but spills to CPU on 8 GB (slow)
#   qwen2.5vl:3b          small and fast, weaker on detail
#   granite3.2-vision:2b  tiny, weak on dense text
VISION_MODEL=qwen3-vl:4b

# Release VRAM quickly so other GPU workloads (e.g. Whisper) can use the card.
VISION_KEEP_ALIVE=60s

VISION_NUM_CTX=16384
# Reasoning models (qwen3-vl) spend budget on hidden reasoning first: give
# them room, or the answer comes back empty.
VISION_NUM_PREDICT=3000
VISION_TEMPERATURE=0.0

# Reasoning models: false hides the reasoning trace and answers directly.
# Leave empty for non-reasoning models.
VISION_THINK=false

VISION_REQUEST_TIMEOUT_SECONDS=300

# Retries when Ollama aborts with "token repeat limit reached" (runner-state
# bug). Each retry unloads the model so the next attempt starts fresh. 0 = off.
VISION_ABORT_RETRIES=2

# Downscale long edge before sending; 0 disables resizing.
# Keep >= 1500 for OCR of small text, lower it if you hit CUDA OOM.
VISION_MAX_IMAGE_SIDE=1600
VISION_JPEG_QUALITY=95

VISION_MAX_UPLOAD_MB=25
VISION_MAX_IMAGES_PER_REQUEST=8
VISION_MAX_CONCURRENT_REQUESTS=1

# --- nightly archive indexer (see indexer/README.md) ---
# false = container idles and never touches the GPU; true = index in the window.
INDEXER_ENABLED=false
# Windows path to the media archive, mounted read-only into the indexer.
INDEXER_MEDIA_HOST=/mnt/d/home_share/медиа
# Which prompts to run per image: scene, objects, text (comma-separated).
INDEXER_PROMPTS=scene,objects
# Model per request; fallback is used only when the main one fails on an image.
INDEXER_MODEL=qwen3-vl:4b
INDEXER_FALLBACK_MODEL=qwen2.5vl:3b
# Nightly working window, 24h local time.
INDEXER_WINDOW=00:00-07:00
INDEXER_TZ=Europe/Moscow
